# Скопируйте этот файл в .env и впишите свои значения.
#   cp .env.example .env
# Файл .env в git не попадает.
#
# На самом сайте эти же переменные задаются в Netlify:
# Site configuration → Environment variables.
# Для локальной админки (python3 server.py) CMS_* обязательны.

# Токен бота от @BotFather
BOT_TOKEN=

# Куда присылать заявки. Узнать: написать боту /start, затем открыть
# https://api.telegram.org/bot<ТОКЕН>/getUpdates и взять result[0].message.chat.id
CHAT_ID=

# Админка. Логин обязателен, значения по умолчанию нет.
# Локально: скопируйте .env.example → .env и заполните, затем python3 server.py
# На Netlify: те же ключи в Site configuration → Environment variables.
CMS_LOGIN=

# SHA-256 пароля (тот же хеш, что на Netlify). Не менее 20 символов у самого пароля.
# python3 -c "import hashlib,sys; print(hashlib.sha256(sys.argv[1].encode()).hexdigest())" 'ПАРОЛЬ'
# или: node -e "console.log(require('node:crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" 'ПАРОЛЬ'
CMS_PASSWORD_HASH=

# Секрет для /api/health (не короче 16 символов). Без него эндпоинт отвечает 503.
# Проверка: curl -H "Authorization: Bearer $HEALTH_TOKEN" https://…/api/health
# или: /api/health?token=…
HEALTH_TOKEN=
